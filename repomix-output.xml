<file path="supabase/migraciones/009_horario_comida.sql">
-- Clínica Nova · Migración 009
-- Horario de consulta en dos bloques, para dejar libre la hora de comida.
-- Antes cada médico tenía un bloque corrido de 09:00 a 14:00, lo que ofrecía
-- citas a las 13:00 y 13:30, justo cuando el médico está comiendo.
--
-- Ahora la jornada se parte en dos:
--   · mañana     09:00 – 13:00
--   · comida     13:00 – 14:00  (no se ofrece ninguna cita)
--   · tarde      14:00 – 18:00
--
-- La tabla `agenda_medicos` ya permite varios bloques por día, y el cálculo de
-- disponibilidad (cargarDisponibilidad) los recorre todos, así que el hueco de
-- la comida se respeta sin cambiar código.
-- Idempotente: puede ejecutarse más de una vez sin duplicar bloques.

--  1. Quita los bloques antiguos de jornada corrida.
delete from public.agenda_medicos
where hora_inicio = '09:00:00'
  and hora_fin = '14:00:00';

--  2. Inserta los dos bloques de consulta, de lunes a viernes, para todo
--     médico activo. `where not exists` evita duplicar si se corre dos veces.
insert into public.agenda_medicos (medico_id, dia_semana, hora_inicio, hora_fin, duracion_slot)
select m.id, d.dia_semana, v.inicio, v.fin, 30
from public.perfiles_medicos m
cross join (values (1), (2), (3), (4), (5)) as d(dia_semana)
cross join (values
  ('09:00'::time, '13:00'::time),
  ('14:00'::time, '18:00'::time)
) as v(inicio, fin)
where m.esta_activo = true
  and not exists (
    select 1 from public.agenda_medicos a
    where a.medico_id = m.id
      and a.dia_semana = d.dia_semana
      and a.hora_inicio = v.inicio
  );

-- Verificación: cada médico debe tener 10 bloques (5 días × 2 turnos).
select
  m.id as medico_id,
  count(a.id) as bloques,
  min(a.hora_inicio) as inicio,
  max(a.hora_fin) as fin
from public.perfiles_medicos m
left join public.agenda_medicos a on a.medico_id = m.id
where m.esta_activo = true
group by m.id
order by m.id;
</file>

<file path="supabase/migraciones/010_quitar_paciente_doc.sql">
-- Clínica Nova · Migración 010
-- Revierte la migración 008: doc@doc.com vuelve a ser solo médico.
--
-- Contexto: en la 008 se le creó un perfil de paciente para que pudiera
-- agendar citas para sí mismo. La decisión correcta es otra: en "Nueva cita"
-- el usuario agenda a un PACIENTE, y doc@doc.com es médico, así que no debe
-- aparecer en esa lista. Su perfil de médico (perfiles_medicos) no se toca.
-- Idempotente: puede ejecutarse más de una vez sin afectar nada.

delete from public.perfiles_pacientes p
using public.usuarios u
where p.usuario_id = u.id
  and u.correo = 'doc@doc.com';

-- Verificación: debe conservar su rol y su perfil de médico, y no tener perfil
-- de paciente.
select
  u.correo,
  u.rol,
  (select count(*) from public.perfiles_medicos  m where m.usuario_id = u.id) as perfiles_medico,
  (select count(*) from public.perfiles_pacientes p where p.usuario_id = u.id) as perfiles_paciente
from public.usuarios u
where u.correo = 'doc@doc.com';
</file>

<file path="supabase/migraciones/011_agenda_fin_de_semana.sql">
-- Clínica Nova · Migración 011
-- La clínica atiende también sábados y domingos.
--
-- Hasta ahora `agenda_medicos` solo tenía bloques de lunes a viernes
-- (dia_semana 1 a 5). Como `cargarDisponibilidad` descarta los días sin bloques
-- (`if (bloques.length === 0) continue`), el sábado y el domingo nunca aparecían
-- en el modal de agendar: la aplicación no ofrecía esos días aunque la clínica
-- atienda.
--
-- `dia_semana` sigue la convención de `Date.getDay()`, que es la que usa
-- `cargarDisponibilidad` al comparar contra la fecha elegida:
--   0 = domingo, 1 = lunes, ... 6 = sábado
-- El CHECK de la tabla ya lo permite (`between 0 and 6`), así que no hace falta
-- alterarla.
--
-- Se repiten los mismos dos bloques que entre semana, en Slots de 30 minutos:
--   · mañana  09:00 – 13:00
--   · tarde   14:00 – 18:00
-- Idempotente: se puede ejecutar más de una vez sin duplicar bloques.

insert into public.agenda_medicos (medico_id, dia_semana, hora_inicio, hora_fin, duracion_slot)
select m.id, d.dia_semana, v.inicio, v.fin, 30
from public.perfiles_medicos m
cross join (values (0), (6)) as d(dia_semana)          -- 0 = domingo, 6 = sábado
cross join (values
  ('09:00'::time, '13:00'::time),
  ('14:00'::time, '18:00'::time)
) as v(inicio, fin)
where m.esta_activo = true
on conflict (medico_id, dia_semana, hora_inicio) do nothing;

-- Verificación: cada médico activo debe quedar con 14 bloques
-- (7 días × 2 turnos). Antes eran 10 (5 días × 2 turnos).
select
  m.id as medico_id,
  (select nombre_completo from public.usuarios where id = m.usuario_id) as medico,
  count(a.id) as bloques,
  count(distinct a.dia_semana) as dias,
  min(a.hora_inicio) as inicio,
  max(a.hora_fin) as fin
from public.perfiles_medicos m
left join public.agenda_medicos a on a.medico_id = m.id
where m.esta_activo = true
group by m.id
order by m.id;
</file>

<file path="supabase/migraciones/012_horarios_por_medico.sql">
-- Clínica Nova · Migración 012
-- Horarios reales de cada médico.
--
-- Reemplaza la agenda uniforme que se había sembrado (09:00-13:00 y 14:00-18:00,
-- los 7 días, para los 6 médicos) por los tres bloques de consulta que atiende
-- cada uno. Ahora los médicos tienen horarios distintos entre sí.
--
-- Los bloques se guardan como ventanas de disponibilidad; dentro de cada una
-- `cargarDisponibilidad` genera los huecos de `duracion_slot` minutos.
--
--   id 8  Dr. Carlos Mendoza      Medicina general   Mañana
--         06:30-07:00 · 13:00-14:00 · 20:30-21:30
--   id 9  Dra. Ana López Martínez Medicina general   Tarde
--         08:00-09:00 · 14:00-15:00 · 21:00-22:00
--   id 10 Dr. Jorge Méndez Ruiz   Cardiología        Mañana
--         07:00-07:45 · 13:30-14:30 · 20:00-21:00
--   id 11 Dra. Laura Sánchez Ortiz Pediatría         Tarde
--         09:00-10:00 · 15:00-16:00 · 21:30-22:30
--   id 12 Dr. Carlos Ramírez Peña  Traumatología     Mañana / Quirófano
--         06:00-06:45 · 14:00-15:00 · 20:00-21:00
--   id 13 Dra. Sofía Herrera Díaz Dermatología       Mixto
--         08:30-09:30 · 14:00-15:00 · 20:00-21:00
--
-- Los `perfiles_medicos.id` no se concretan a mano: se resuelven por nombre, que
-- es lo único estable entre entornos.
--
-- NOTA: las citas que ya existían estaban dentro de la agenda anterior y con
-- este cambio quedan fuera del horario del médico. Revisar `citas` después de
-- aplicar.
-- Idempotente: se puede ejecutar más de una vez.

--  1. Borra toda la agenda anterior: la de migración 011 y cualquier otra.
delete from public.agenda_medicos;

--  2. Inserta los bloques reales de cada médico, los 7 días de la semana.
insert into public.agenda_medicos (medico_id, dia_semana, hora_inicio, hora_fin, duracion_slot)
select m.id, d.dia_semana, b.inicio, b.fin, 15
from public.perfiles_medicos m
join (
  values
    ('Dr. Carlos Mendoza',      '06:30'::time, '07:00'::time),
    ('Dr. Carlos Mendoza',      '13:00'::time, '14:00'::time),
    ('Dr. Carlos Mendoza',      '20:30'::time, '21:30'::time),
    ('Dra. Ana López Martínez', '08:00'::time, '09:00'::time),
    ('Dra. Ana López Martínez', '14:00'::time, '15:00'::time),
    ('Dra. Ana López Martínez', '21:00'::time, '22:00'::time),
    ('Dr. Jorge Méndez Ruiz',   '07:00'::time, '07:45'::time),
    ('Dr. Jorge Méndez Ruiz',   '13:30'::time, '14:30'::time),
    ('Dr. Jorge Méndez Ruiz',   '20:00'::time, '21:00'::time),
    ('Dra. Laura Sánchez Ortiz','09:00'::time, '10:00'::time),
    ('Dra. Laura Sánchez Ortiz','15:00'::time, '16:00'::time),
    ('Dra. Laura Sánchez Ortiz','21:30'::time, '22:30'::time),
    ('Dr. Carlos Ramírez Peña',  '06:00'::time, '06:45'::time),
    ('Dr. Carlos Ramírez Peña',  '14:00'::time, '15:00'::time),
    ('Dr. Carlos Ramírez Peña',  '20:00'::time, '21:00'::time),
    ('Dra. Sofía Herrera Díaz', '08:30'::time, '09:30'::time),
    ('Dra. Sofía Herrera Díaz', '14:00'::time, '15:00'::time),
    ('Dra. Sofía Herrera Díaz', '20:00'::time, '21:00'::time)
) as b(medico, inicio, fin) on b.medico = u.nombre_completo
cross join (values (0), (1), (2), (3), (4), (5), (6)) as d(dia_semana)
join public.usuarios u on u.id = m.usuario_id
on conflict (medico_id, dia_semana, hora_inicio) do nothing;

-- Verificación: 6 médicos × 3 bloques × 7 días = 126 filas.
select
  u.nombre_completo as medico,
  m.especialidad,
  count(a.id) as bloques,
  count(distinct a.dia_semana) as dias,
  string_agg(distinct to_char(a.hora_inicio, 'HH24:MI') || '-' || to_char(a.hora_fin, 'HH24:MI'), ' · ' order by a.hora_inicio) as ventanas
from public.perfiles_medicos m
join public.usuarios u on u.id = m.usuario_id
left join public.agenda_medicos a on a.medico_id = m.id
where m.esta_activo = true
group by m.id, u.nombre_completo, m.especialidad
order by m.id;
</file>

<file path="supabase/migraciones/013_intervalo_25_min.sql">
-- Clínica Nova · Migración 013
-- Intervalo de 25 minutos por cita, para todos los médicos.
--
-- La app usa DOS valores distintos y ambos tienen que coincidir:
--
--   perfiles_medicos.duracion_consulta -> cuánto dura la cita al guardarse
--   agenda_medicos.duracion_slot       -> cada cuánto se OFRECE un horario
--
-- Con la migración 012 quedaron en 15 y 20/25/30 respectivamente, así que la
-- pantalla ofrecía horarios que se traslapan entre sí: se veían 8:30 y 8:45 a
-- la vez, pero al agendar 8:30 (que dura hasta las 8:50) el de 8:45 ya no se
-- podía guardar y Postgres lo rechazaba con `citas_no_traslape`.
--
-- Aquí se alinean los dos en 25 minutos. Así lo que se ve es lo que se puede
-- agendar, y un cardiólogo (antes 30) deja de solaparse con el paso de 25.
--
-- Con ventanas de 60 min esto da 2 citas por ventana: 13:00 y 13:25.
-- Idempotente: se puede ejecutar más de una vez.

update public.perfiles_medicos
set duracion_consulta = 25
where esta_activo = true
  and duracion_consulta is distinct from 25;

update public.agenda_medicos
set duracion_slot = 25
where duracion_slot is distinct from 25;

-- Verificación: no debe quedar ningún médico cuyo paso y su duración difieran,
-- porque eso es justo lo que genera los horarios traslapados.
select
  m.id as medico_id,
  u.nombre_completo as medico,
  m.duracion_consulta,
  min(a.duracion_slot) as duracion_slot_min,
  max(a.duracion_slot) as duracion_slot_max,
  (m.duracion_consulta = min(a.duracion_slot)) as coinciden
from public.perfiles_medicos m
join public.usuarios u on u.id = m.usuario_id
left join public.agenda_medicos a on a.medico_id = m.id
where m.esta_activo = true
group by m.id, u.nombre_completo, m.duracion_consulta
order by m.id;
</file>

<file path="supabase/migraciones/014_bloques_50_min.sql">
-- Clínica Nova · Migración 014
-- Bloques de 50 minutos: 2 citas exactas por bloque, sin minutos perdidos.
--
-- Con citas de 25 minutos (migración 013), las ventanas de la 012 no eran
-- múltiplos de 25, así que el final de cada bloque siempre se desperdiciaba:
--
--   06:30-07:00  30 min -> 1 cita  (se pierden  5 min)
--   07:00-07:45  45 min -> 1 cita  (se pierden 20 min)
--   13:00-14:00  60 min -> 2 citas (se pierden 10 min)
--
-- Mendoza tenía 2.5 h de consulta y daba 5 citas cuando en su jornada cabían
-- 6. Ahora cada bloque dura 50 min, que son exactamente 2 citas de 25:
--
--   06:30-07:20  ->  6:30 y 6:55
--   13:00-13:50  ->  13:00 y 13:25
--   20:30-21:20  ->  20:30 y 20:55     = 6 citas/día, 0 min perdidos
--
-- Se conserva la hora de INICIO de cada bloque, que es lo que distingue a un
-- médico de otro: solo se extiende el final 10-20 min. La clínica atiende en la
-- misma franja que antes y deja de tirar tiempo de consulta.
--
-- OJO: esto no tiene que ver con la cortesía de check-in (`MINUTOS_CORTESIA = 10`
-- en proximas-citas.tsx). Ahí los 10 min son el margen que tiene el paciente
-- para presentarse antes de que la cita pase a "Reagendar"; no participan en la
-- generación de horarios.
--
--  · Dr. Carlos Mendoza       06:30-07:20 · 13:00-13:50 · 20:30-21:20
--  · Dra. Ana López Martínez  08:00-08:50 · 14:00-14:50 · 21:00-21:50
--  · Dr. Jorge Méndez Ruiz    07:00-07:50 · 13:30-14:20 · 20:00-20:50
--  · Dra. Laura Sánchez Ortiz 09:00-09:50 · 15:00-15:50 · 21:30-22:20
--  · Dr. Carlos Ramírez Peña  06:00-06:50 · 14:00-14:50 · 20:00-20:50
--  · Dra. Sofía Herrera Díaz  08:30-09:20 · 14:00-14:50 · 20:00-20:50
--
-- Los `perfiles_medicos.id` no se concretan a mano: se resuelven por nombre,
-- igual que en la 012.
--
-- ATENCIÓN: como la 012, esto deja fuera de su agenda las citas que ya tuvieran.
-- La app no las mueve sola; el panel las sigue mostrando y `reagendar` ofrece
-- horarios nuevos.
-- Idempotente: se puede ejecutar más de una vez.

--  1. Borra la agenda anterior (la de la 012).
delete from public.agenda_medicos;

--  2. Inserta los bloques de 50 min de cada médico, los 7 días de la semana.
insert into public.agenda_medicos (medico_id, dia_semana, hora_inicio, hora_fin, duracion_slot)
select m.id, d.dia_semana, b.inicio, b.fin, 25
from public.perfiles_medicos m
join (
  values
    ('Dr. Carlos Mendoza',      '06:30'::time, '07:20'::time),
    ('Dr. Carlos Mendoza',      '13:00'::time, '13:50'::time),
    ('Dr. Carlos Mendoza',      '20:30'::time, '21:20'::time),
    ('Dra. Ana López Martínez', '08:00'::time, '08:50'::time),
    ('Dra. Ana López Martínez', '14:00'::time, '14:50'::time),
    ('Dra. Ana López Martínez', '21:00'::time, '21:50'::time),
    ('Dr. Jorge Méndez Ruiz',   '07:00'::time, '07:50'::time),
    ('Dr. Jorge Méndez Ruiz',   '13:30'::time, '14:20'::time),
    ('Dr. Jorge Méndez Ruiz',   '20:00'::time, '20:50'::time),
    ('Dra. Laura Sánchez Ortiz','09:00'::time, '09:50'::time),
    ('Dra. Laura Sánchez Ortiz','15:00'::time, '15:50'::time),
    ('Dra. Laura Sánchez Ortiz','21:30'::time, '22:20'::time),
    ('Dr. Carlos Ramírez Peña',  '06:00'::time, '06:50'::time),
    ('Dr. Carlos Ramírez Peña',  '14:00'::time, '14:50'::time),
    ('Dr. Carlos Ramírez Peña',  '20:00'::time, '20:50'::time),
    ('Dra. Sofía Herrera Díaz', '08:30'::time, '09:20'::time),
    ('Dra. Sofía Herrera Díaz', '14:00'::time, '14:50'::time),
    ('Dra. Sofía Herrera Díaz', '20:00'::time, '20:50'::time)
) as b(medico, inicio, fin) on b.medico = u.nombre_completo
cross join (values (0), (1), (2), (3), (4), (5), (6)) as d(dia_semana)
join public.usuarios u on u.id = m.usuario_id
on conflict (medico_id, dia_semana, hora_inicio) do nothing;

-- Verificación 1: 6 médicos × 3 bloques × 7 días = 126 filas.
select count(*) as bloques from public.agenda_medicos;

-- Verificación 2: `sobrante` debe salir 0 en todas las filas. Es el minuto que
-- se pierde al final de cada bloque: si un bloque no fuera múltiplo de 25, la
-- pantalla ofrecería una cita menos de las que ese bloque realmente aloja.
select distinct
  extract(epoch from (hora_fin - hora_inicio)) / 60 as min_bloque,
  (extract(epoch from (hora_fin - hora_inicio)) / 60) % 25 as sobrante,
  (extract(epoch from (hora_fin - hora_inicio)) / 60) / 25 as citas_del_bloque
from public.agenda_medicos
order by 1;
