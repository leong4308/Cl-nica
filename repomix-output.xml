<file path="supabase/migraciones/015_horario_continuo.sql">
-- Clínica Nova · Migración 015
-- Jornada de tarde, 14 citas cada 25 minutos, de lunes a domingo.
--
-- La 015 original daba 4 ventanas de 6:00 AM a 7:40 PM (29 citas). La clínica
-- pidió que toda la semana se ofrezca EXACTAMENTE la misma tarde que se ve en el
-- panel, así que la mañana se retira por completo:
--
--   13:00-14:15    3 citas   1:00 PM ... 1:50 PM
--   15:30-20:05   11 citas   3:30 PM ... 7:40 PM
--                                  = 14 citas por médico por día
--
-- No se ofrece nada entre las 1:50 PM y las 3:30 PM (la hora de la comida).
--
-- POR QUÉ SON 2 BLOQUES Y NO 1
-- El generador de horarios recorre cada bloque sumando `duracion_slot` mientras
-- quepa dentro de `hora_fin` (lib/supabase/datos.ts:633) y no sabe saltarse
-- huecos. Para dejar la comida fuera hay que partir la tarde en dos bloques.
--
-- POR QUÉ EL PRIMER BLOQUE TERMINA EN 14:15 Y NO EN 14:40
-- Con `hora_fin = 14:40` entraría la cita de 2:15 PM (14:15 + 25 = 14:40 <=
-- 14:40), que la clínica no quiere. Con 14:15 se cumple 13:50 + 25 = 14:15 <=
-- 14:15 (entra la de 1:50 PM) pero 14:15 + 25 = 14:40 > 14:15 (no entra la de
-- 2:15 PM). El límite es el único que produce exactamente esas 14 citas.
--
-- POR QUÉ EL SEGUNDO BLOQUE EMPIEZA EN 15:30 Y NO EN 15:05
-- De la misma forma: 15:05 daría la cita de 3:05 PM, que tampoco se ofrece.
-- Empezando en 15:30 la primera es la de 3:30 PM y la última, 19:40 + 25 =
-- 20:05 <= 20:05, es la de 7:40 PM.
--
-- AMBOS BLOQUES SON MÚLTIPLOS EXACTOS DE 25 MIN (75 y 275), así que no se
-- pierde ni un minuto de consulta: verificación 2 al final del archivo.
--
-- OJO: esto no tiene que ver con la cortesía de check-in (`MINUTOS_CORTESIA = 10`
-- en proximas-citas.tsx). Ahí los 10 min son el margen que tiene el paciente
-- para presentarse antes de que la cita pase a "Reagendar".
--
-- Los `perfiles_medicos.id` no se concretan a mano: se resuelven por nombre,
-- igual que en la 012 y la 014.
--
-- ATENCIÓN: esto deja fuera de su agenda las 12 citas que ya existen en horas de
-- la mañana o en el hueco de la comida. La app no las mueve sola; el panel las
-- sigue mostrando y `reagendar` ofrece horarios nuevos. La prueba
-- "las citas nuevas caen dentro del horario del médico" las lista a propósito
-- en `CITAS_FUERA_DEL_HORARIO_ACTUAL` para que una cita fuera de horario que NO
-- sea heredada haga fallar la suite.
-- Idempotente: se puede ejecutar más de una vez.

--  1. Borra la agenda anterior.
delete from public.agenda_medicos;

--  2. Inserta las 2 ventanas de la tarde de cada médico, los 7 días.
insert into public.agenda_medicos (medico_id, dia_semana, hora_inicio, hora_fin, duracion_slot)
select m.id, d.dia_semana, b.inicio, b.fin, 25
from public.perfiles_medicos m
join (
  values
    ('13:00'::time, '14:15'::time),
    ('15:30'::time, '20:05'::time)
) as b(inicio, fin) on true
cross join (values (0), (1), (2), (3), (4), (5), (6)) as d(dia_semana)
where m.esta_activo = true
on conflict (medico_id, dia_semana, hora_inicio) do nothing;

-- Verificación 1: 6 médicos × 2 ventanas × 7 días = 84 filas.
select count(*) as bloques from public.agenda_medicos;

-- Verificación 2: `citas` debe salir siempre un entero: cada ventana es un
-- múltiplo exacto de 25 min, así que no se pierde ni un minuto de consulta.
select distinct
  extract(epoch from (hora_fin - hora_inicio)) / 60 as min_bloque,
  (extract(epoch from (hora_fin - hora_inicio)) / 60) / 25 as citas_del_bloque,
  (extract(epoch from (hora_fin - hora_inicio)) / 60) % 25 as sobrante
from public.agenda_medicos
order by 1;

-- Verificación 2: `citas` debe salir siempre un entero: cada ventana es un
-- múltiplo exacto de 25 min, así que no se pierde ni un minuto de consulta.
select distinct
  extract(epoch from (hora_fin - hora_inicio)) / 60 as min_bloque,
  (extract(epoch from (hora_fin - hora_inicio)) / 60) / 25 as citas_del_bloque,
  (extract(epoch from (hora_fin - hora_inicio)) / 60) % 25 as sobrante
from public.agenda_medicos
order by 1;
</file>

<file path="app/auth/callback/route.ts">
import { NextResponse } from 'next/server'
import { createClient } from '@/lib/supabase/server'

export async function GET(request: Request) {
  const url = new URL(request.url)
  const code = url.searchParams.get('code')
  const next = url.searchParams.get('next') || '/'

  if (code) {
    const supabase = await createClient()
    await supabase.auth.exchangeCodeForSession(code)
  }

  return NextResponse.redirect(new URL(next, url.origin))
}
</file>

