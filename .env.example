# URL del proyecto de Supabase (Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://dcsmkxlxblisemjrsudc.supabase.co

# Clave publicable del proyecto (Project Settings > API Keys)
# En proyectos nuevos se llama "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__6FZ5ZBPUwK4wf0fOzW4ow_zODwabwT

# Alternativa para proyectos con el esquema antiguo de claves
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo servidor. NUNCA expongas esta variable con el prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE

# Accesos de prueba en el login: activos por defecto en desarrollo y ocultos en producción.
# true permite mostrarlos en un entorno de pruebas desplegado; false los oculta también en desarrollo.
# HABILITAR_ACCESOS_PRUEBA=false
# CLAVE_CUENTAS_PRUEBA=CONTRASENA_DE_LAS_CUENTAS_DE_PRUEBA

# Conexión SQL de Supabase > Connect > URI. Solo scripts de administración.
# Usa la contraseña de la base; nunca una clave NEXT_PUBLIC_.
# SUPABASE_DB_URL=postgresql://postgres.PROYECTO:CONTRASENA@HOST:5432/postgres
# Certificado público oficial incluido para verificar la conexión SQL.
# SUPABASE_DB_CA_FILE=certificados/supabase-ca-2021.crt

# Respaldos: la clave se genera con pnpm respaldo:clave y queda en .backup.key.
# En servidores/CI usa BACKUP_ENCRYPTION_KEY (32 bytes aleatorios en base64).
# BACKUP_KEY_FILE=.backup.key
# BACKUP_DIR=respaldos
# PG_DUMP_BIN=C:/PostgreSQL/bin/pg_dump.exe
# PG_RESTORE_BIN=C:/PostgreSQL/bin/pg_restore.exe

# Restauración de prueba: proyecto vacío diferente del original.
# RESTORE_DB_URL=postgresql://USUARIO:CONTRASENA@HOST-PRUEBA:5432/postgres
# RESTORE_SUPABASE_URL=https://PROYECTO-PRUEBA.supabase.co
# RESTORE_SERVICE_ROLE_KEY=CLAVE_DE_SERVICIO_DEL_PROYECTO_DE_PRUEBA
